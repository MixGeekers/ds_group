{
  "name": "@shiyu/runtime",
  "version": "0.1.0",
  "description": "识雨本体：原生会话、事件协作与运行仪表盘。",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "dist",
    "client",
    "locale",
    "assets",
    "licenses",
    "service/ombre/*.py",
    "service/ombre/*.json",
    "service/ombre/*.txt",
    "service/ombre/*.md",
    "service/ombre/LICENSE",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "playwright test --config tests/ui/playwright.config.mjs",
    "check": "npm run typecheck && npm test && npm run build && node --check client/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@modelcontextprotocol/client": "2.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    }
  }
}
